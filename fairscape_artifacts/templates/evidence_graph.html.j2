{% extends "base.html.j2" %}

{% block head %}
<style>{{ reactflow_css }}</style>
{%- endblock %}

{% block main %}
<p class="page-note">Outputs on the left, inputs on the right &mdash; click a node for its details.</p>
{%- if other_crates|default([]) %}
<p class="page-note">This chain leaves this crate: {% for name, count in other_crates %}<strong>{{ count }}</strong> {{ 'entity' if count == 1 else 'entities' }} described in {{ name }}{{ '; ' if not loop.last else '' }}{% endfor %}.</p>
{%- endif %}
<div id="evidence-graph"></div>
{%- endblock %}

{% block scripts %}
<script>window.__EVIDENCE_GRAPH__ = {{ graph_json }};</script>
<script>{{ viewer_js }}</script>
{%- endblock %}
