<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>{{ style_css }}</style>
{%- block head %}{% endblock %}
</head>
<body class="{{ body_class|default('') }}">
{%- block nav %}{% endblock %}

<header class="hero">
  <div class="hero-inner">
    <p class="kicker">{{ kicker }}</p>
    <h1>{{ title }}</h1>
    {%- if ark %}
    <p class="ark">{% if ark_href|default('') %}<a href="{{ ark_href }}">{{ ark }}</a>{% else %}{{ ark }}{% endif %}</p>
    {%- endif %}
    {%- if badges|default([]) %}
    <p class="badges">
      {%- for badge in badges %}
      {% if badge.href %}<a class="hbadge" href="{{ badge.href }}" target="_blank" rel="noopener" title="{{ badge.title }}">{{ badge.label }} &#8599;</a>{% else %}<span class="hbadge">{{ badge.label }}</span>{% endif %}
      {%- endfor %}
    </p>
    {%- endif %}
    {%- if description %}
    <p class="desc">{{ description }}</p>
    {%- endif %}
    {%- if chips %}
    <p class="chips">{% for chip in chips %}<span class="chip">{{ chip }}</span> {% endfor %}</p>
    {%- endif %}
  </div>
</header>

<main>
{%- block main %}{% endblock %}
{%- block footer %}
<footer>
  Generated by fairscape-artifacts{% if source %} from {{ source }}{% endif %} on {{ generated_at }}.
</footer>
{%- endblock %}
</main>
{%- block scripts %}{% endblock %}

</body>
</html>
